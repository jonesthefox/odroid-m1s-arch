# Config env for build_u-boot.sh

# Full path to the directory you want to clone the git repos used
ROOTPATH="/tmp/build_u-boot"
# Full path to your custom u-boot .config file
#CUSTOM_CONFIG="./config/u-boot.config"
CUSTOM_CONFIG="./config/u-boot.config.optee"

REPO_RKBIN="https://github.com/rockchip-linux/rkbin.git"
REPO_TFA="https://github.com/ARM-software/arm-trusted-firmware.git"
#REPO_TFA="https://github.com/TrustedFirmware-A/trusted-firmware-a.git"
REPO_OPTEE="https://github.com/OP-TEE/optee_os.git"
REPO_UBOOT="https://source.denx.de/u-boot/u-boot.git"
# You can set a specific u-boot branch, i.e. if you want to fiddle with another device:
REPO_UBOOT_BRANCH="master"

TFA_PLATFORM="rk3568"
OPTEE_PLATFORM="rockchip"
OPTEE_FLAVOR="rk3566"
OPTEE_ARCH="arm"
OPTEE_FDT_ADDR=0x12000000
OPTEE_RAM_BITS=32

CROSS_COMPILE=arm-linux-gnueabi-
CROSS_COMPILE64=aarch64-linux-gnu-

UBOOT_IMG_TYPE=rksd

DEFCONFIG="odroid-m1s-rk3566_defconfig"
ARCH="arm64"
VARIANT="RK3566"
BAUDRATE=1500000
